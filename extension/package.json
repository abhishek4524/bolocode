{
  "name": "bolocode-extension",
  "displayName": "BoloCode — Voice Coding Agent",
  "description": "Local WebSocket bridge for the BoloCode voice-first coding agent. Controls VS Code hands-free using natural Hindi, English, or Hinglish speech.",
  "version": "0.1.0",
  "publisher": "bolocode",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishek4524/bolocode.git"
  },
  "homepage": "https://github.com/abhishek4524/bolocode#readme",
  "bugs": {
    "url": "https://github.com/abhishek4524/bolocode/issues"
  },
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "keywords": [
    "voice", "speech", "hindi", "hinglish", "coding assistant",
    "hands-free", "accessibility", "ai agent", "bolocode", "voice control"
  ],
  "categories": [
    "Other",
    "Programming Languages",
    "AI"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bolocode.startServer",
        "title": "BoloCode: Start Voice Agent Server",
        "icon": "$(mic)"
      },
      {
        "command": "bolocode.stopServer",
        "title": "BoloCode: Stop Voice Agent Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "bolocode.showConnectionInfo",
        "title": "BoloCode: Show Connection Info",
        "icon": "$(info)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=out/extension.js",
    "watch": "tsc -w -p ./",
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=out/extension.js",
    "test": "jest --testPathPattern=src/__tests__ --passWithNoTests",
    "package": "npx @vscode/vsce package --no-git-tag-version"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/src/__mocks__/vscode.ts"
    },
    "testMatch": [
      "**/src/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": ["/node_modules/", "/out/"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "module": "commonjs" } }]
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.20.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
